    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "@nexus/shared": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.1",
    "js-yaml": "^5.3.0",
    "typebox": "^1.3.16",
    "uuid": "^14.0.2",
    "ws": "^8.21.3"
